{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cross-sync/cron",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/widget/cron",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/widget/cron?run=late",
      "schedule": "30 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
