# ── Database (Neon / any Postgres) ──────────────────────────────────────────
# Get a free DB at https://neon.tech → Project → Connection string
DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRE=30d

# ── Google OAuth (for "Continuer avec Google") ───────────────────────────────
# 1. Go to https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Authorized redirect URI: https://your-domain.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# Intervals.icu OAuth
INTERVALS_CLIENT_ID=your-intervals-app-id
INTERVALS_CLIENT_SECRET=your-intervals-app-secret
INTERVALS_CALLBACK_URL=https://your-domain.vercel.app/api/auth/intervals/callback

# Strava OAuth
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
STRAVA_CALLBACK_URL=https://your-domain.vercel.app/api/auth/strava/callback

# Garmin OAuth
GARMIN_CLIENT_ID=your-garmin-client-id
GARMIN_CLIENT_SECRET=your-garmin-client-secret
GARMIN_CALLBACK_URL=https://your-domain.vercel.app/api/auth/garmin/callback

# Wahoo OAuth
WAHOO_CLIENT_ID=your-wahoo-client-id
WAHOO_CLIENT_SECRET=your-wahoo-client-secret
WAHOO_CALLBACK_URL=https://your-domain.vercel.app/api/auth/wahoo/callback

# Frontend
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
